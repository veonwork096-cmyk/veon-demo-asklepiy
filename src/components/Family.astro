---
import { Picture } from "astro:assets";
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import BookButton from "./BookButton.astro";
import pediatrician from "../assets/photos/pediatrician.webp";
---
<Section id="family" rec="R-006,S-R022" class="section family" label="Сімейний лікар безоплатно">
  <div class="container family__grid">
    <div class="family__text">
      <h2>Сімейний лікар безоплатно</h2>
      <p class="family__lead">«Асклепій Родина»: декларація з сімейним лікарем або педіатром за програмою медичних гарантій — договір з НСЗУ, пакет «Первинна медична допомога».</p>

      <p class="family__say">Паспорт. ІПН. Телефон.</p>
      <p class="family__say-cap">Це все, що треба взяти з собою.</p>

      <ol class="family__steps">
        <li><span class="family__n">1</span><span>Оберіть сімейного лікаря або педіатра</span></li>
        <li><span class="family__n">2</span><span>Прийдіть із паспортом, ІПН і телефоном</span></li>
        <li><span class="family__n">3</span><span>Підпишіть декларацію на прийомі</span></li>
      </ol>

      <div class="family__actions">
        <BookButton label="Обрати сімейного лікаря" size="l" />
        <FutureLink note="Розділ у розробці">Сімейні лікарі та педіатри</FutureLink>
      </div>
    </div>

    <figure class="photo family__photo">
      <Picture src={pediatrician} alt="Лікарка-педіатр і маленький пацієнт дають «п'ять» у кабінеті клініки" widths={[640, 1024, 1600]} sizes="(min-width: 900px) 45vw, 100vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" style="object-position: 58% 50%" />
      <figcaption>фото клініки</figcaption>
    </figure>
  </div>
</Section>

<style>
  .family { background: var(--color-brand-surface); }
  .family__grid { display: grid; gap: var(--s-6); grid-template-columns: minmax(0, 1fr); }
  .family__lead { margin: var(--s-2) 0 var(--s-6); font-size: var(--fs-20); line-height: 1.5; color: var(--color-muted); max-width: 40ch; }
  .family__say { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); line-height: 1.05; color: var(--color-accent); letter-spacing: -.01em; }
  .family__say-cap { margin: var(--s-1) 0 var(--s-4); font-weight: 600; }
  .family__steps { list-style: none; margin: 0 0 var(--s-4); padding: 0; display: grid; gap: 0; counter-reset: none; }
  .family__steps li { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: var(--s-2); min-height: 56px; border-top: 1px solid var(--color-line); }
  .family__steps li:last-child { border-bottom: 1px solid var(--color-line); }
  .family__n { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-24); color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .family__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); }
  .family__photo { aspect-ratio: 4 / 5; }
  @media (min-width: 900px) {
    .family__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; }
    .family__text { grid-column: 1 / span 6; }
    .family__photo { grid-column: 8 / span 5; }
  }
  @media (max-width: 599px) { .family__photo { aspect-ratio: 3 / 2; } }
</style>
