---
// Line icons, 24 px grid, currentColor. Decorative: the text next to them carries the meaning.
interface Props { name: "phone" | "telegram" | "viber" | "map" | "chevron" | "close" | "menu" | "mail" | "instagram" | "facebook" | "youtube" | "tiktok" | "arrow-down"; size?: number; class?: string }
const { name, size = 20, class: cls, ...rest } = Astro.props;
const paths: Record<Props["name"], string> = {
  phone: '<path d="M5 3.5h3.2l1.6 4.2-2.1 1.3a11 11 0 0 0 5.3 5.3l1.3-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5C9.4 19 5 14.6 4.5 6.2A2.5 2.5 0 0 1 5 3.5Z"/>',
  telegram: '<path d="M21 4 3 11.2l5.6 2L18 7l-7.2 7.6.2 5.4 3.1-3.6 4.3 3.2L21 4Z"/>',
  viber: '<path d="M12 3c5 0 8.5 2.4 8.5 7.6 0 5.2-3.5 7.4-8.5 7.4-.8 0-1.6 0-2.3-.2L6 20.5v-3.6C4.3 15.6 3.5 13.5 3.5 10.6 3.5 5.4 7 3 12 3Z"/><path d="M9.3 8.2c.3 2.6 1.9 4.5 4.6 5.2l1-1-1.6-1-.7.6c-.8-.4-1.4-1-1.8-1.8l.6-.7-1-1.6-1.1.3Z"/>',
  map: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  chevron: '<path d="m9 5 7 7-7 7"/>',
  "arrow-down": '<path d="M12 5v14M6 13l6 6 6-6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 7 8 6 8-6"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>',
  facebook: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.5V4.4A20 20 0 0 0 15.4 4.3c-2.3 0-3.9 1.4-3.9 4v2.2H9v3h2.5V21"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="m10 9.2 5 2.8-5 2.8V9.2Z"/>',
  tiktok: '<path d="M14 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8M14 3.5c.4 2.6 2.2 4.3 4.8 4.5"/>',
};
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" {...rest} set:html={paths[name]} />
